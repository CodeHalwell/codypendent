{
  "name": "@codypendent/desktop",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/dev-desktop.mjs",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "tauri:build": "tauri build -f app",
    "build:native-window-smoke": "tauri build -f app --debug --no-bundle --config src-tauri/tauri.native-window-smoke.conf.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "perf": "vitest run --config vitest.perf.config.ts",
    "test:native": "node test/native-smoke.mjs",
    "test:native-support": "node --test test/native-smoke-support.test.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@codypendent/protocol": "file:../../sdk/protocol",
    "@codypendent/ui": "file:../../sdk/ui",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^26.0.0",
    "typescript": "^5.5.4",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
