{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codypendent",
  "version": "0.14.0",
  "identifier": "com.codypendent.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Codypendent",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "shortDescription": "Codypendent desktop client",
    "longDescription": "Desktop client for the Codypendent daemon. Connects to a local codypendentd over its Unix domain socket; it never executes tools itself.",
    "resources": {
      "../../../LICENSE": "licenses/CODYPENDENT_LICENSE",
      "../../../third_party/tantivy-sstable/LICENSE": "licenses/TANTIVY_SSTABLE_LICENSE"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
