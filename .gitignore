/target
/book

# Claude Code local state (agent worktrees, local settings). Never committed.
/.claude/

# Bytecode from the doc/eval gate scripts (`.github/scripts/*.py`,
# `evals/ci/*.py`) when they are run locally.
__pycache__/

# The vitest JSON report the `extension` CI job writes for the doc-count gate
# (`.github/scripts/check_doc_test_counts.py --vitest-report`). Ephemeral in
# CI; running the same two commands locally must not leave a tracked artifact.
/vitest-extension.json

# Vendored upstream repos kept locally for reference only. Never committed.
/reference-repos/

# Local state written by codypendent itself when the daemon is run inside its
# own checkout (dogfooding). Same rationale as /.claude/ above: per-machine
# agent state, never part of the source tree.
/.codypendent/

# Scratch directories written by other agent/IDE tooling used against this
# checkout. All per-machine, none reproducible, none reviewable.
/.cursor-tmp/
/.poolside/
/.idea/

# Stray local scratch capture. Not an input to any build or gate.
/300726.txt

# A stray criterion run from the wrong cwd created apps/desktop/src/target/;
# ignore a target dir at ANY depth, not just the workspace root.
**/target/

# Package installs and tool caches (vitest, vite) under any package directory.
node_modules/
