{
  "name": "@codypendent/protocol",
  "version": "1.1.0",
  "description": "Generated TypeScript bindings for the Codypendent daemon wire protocol, pinned to Rust schemas and golden vectors",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "generate": "node ./scripts/generate.mjs --output-dir ./src/generated",
    "check:generated": "../../.github/scripts/check_generated_typescript.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run check:generated && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
